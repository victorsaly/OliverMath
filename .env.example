# Base URL for the Azure Functions backend (no trailing slash).
# .env.development and .env.production already set this; copy to .env.local to override.
VITE_API_BASE_URL=http://localhost:7071

# The store listings, once the apps are live. While both are empty the web
# version has no daily limit; with either set it gets the same free version as
# the apps (10 sums a day) and points to the app for the rest.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
