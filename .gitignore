# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

# Logs
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local

# Azure Functions local settings (contains secrets)
# Wildcard so backups/variants (.bak, .old) can never be committed either
azure/functions/local.settings.json*

# IDE / Editor
/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode

# Build outputs and dependencies
/coverage
/dist
/node_modules
/platforms
/plugins
/www
azure/functions/node_modules

# Capacitor: the native projects are committed (they hold the permission
# texts and app settings). Their own .gitignore files exclude build output.

# Test outputs
/test-results
/cypress/videos
/cypress/screenshots

# Built by `npm run build` and published by the deploy workflow. It was
# committed when Pages served it from the branch; that is no longer how the
# site is deployed.
/docs
