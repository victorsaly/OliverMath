{
  "name": "OliverMath",
  "version": "0.0.15",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-web.mjs",
    "preview": "node scripts/serve-docs.mjs",
    "test": "vitest run && cypress run",
    "test:unit": "vitest run",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "lint": "eslint src --ext .vue,.js,.ts",
    "typecheck": "vue-tsc --noEmit",
    "build:native": "NATIVE_BUILD=1 VITE_NATIVE_BUILD=1 vite build --outDir dist",
    "sync:native": "npm run build:native && cap sync",
    "ios": "npm run sync:native && cap open ios",
    "android": "npm run sync:native && cap open android",
    "film": "node scripts/film/record.mjs && node scripts/film/cut.mjs",
    "ios:archive": "npm run sync:native && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -destination generic/platform=iOS -archivePath \"$HOME/Library/Developer/Xcode/Archives/Oliver Math.xcarchive\" archive",
    "ios:upload": "xcodebuild -exportArchive -archivePath \"$HOME/Library/Developer/Xcode/Archives/Oliver Math.xcarchive\" -exportOptionsPlist ios/App/ExportOptions.plist -exportPath ios/build/export -allowProvisioningUpdates"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.0.1",
    "@capacitor/ios": "^8.6.2",
    "@ionic/vue": "^8.5.0",
    "@ionic/vue-router": "^8.5.0",
    "axios": "^1.13.2",
    "microsoft-cognitiveservices-speech-sdk": "^1.44.0",
    "oliver-device-speech": "file:native/device-speech",
    "three": "^0.186.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue3-lottie": "^3.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^14.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.1.0",
    "vue-tsc": "^2.2.12",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "tar": "^7.5.6",
    "serialize-javascript": "^7.0.3"
  },
  "description": "An Ionic project"
}
